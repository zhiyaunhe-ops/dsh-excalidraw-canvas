{
  "name": "dsh-canvas-session",
  "version": "0.6.0",
  "private": true,
  "description": "Per-session targets for independently running Excalidraw canvases",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./host": "./host.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "index.js",
    "host.js",
    "context.js",
    "client.js"
  ]
}
